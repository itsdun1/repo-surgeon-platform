# Secrets and env — NEVER commit these
.env
.env.local
.env.*.local
.env.production
.env.development
secrets/*
!secrets/.gitkeep
*.pem
*.key
*.crt
*.p12
*.pfx
**/private-key*
**/github-app-private-key*
**/*-credentials*
**/*-token*
**/*.token
auth.json
credentials.json
service-account*.json

# gitagent runtime artifacts
.gitagent/
**/.gitagent/

# Stray dirs gitagent creates if run without --dir
