# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it's in .gitignore.

# --- LLM APIs ---
ANTHROPIC_API_KEY=sk-ant-your-key-here
OPENAI_API_KEY=sk-your-key-here

# --- GitHub App ---
# Created via scripts/setup.sh, which walks you through GitHub App creation
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_PRIVATE_KEY_PATH=./secrets/github-app-private-key.pem
GITHUB_WEBHOOK_SECRET=

# --- Webhook tunnel (pick one) ---
# Option A: smee.io
SMEE_URL=https://smee.io/your-channel-here
# Option B: ngrok (if used instead, set NGROK_URL and adjust GitHub App webhook URL)
# NGROK_URL=

# --- Local services (defaults match docker-compose.yml) ---
DATABASE_URL=postgresql+asyncpg://surgeon:dev@localhost:5432/surgeon
REDIS_URL=redis://localhost:6379/0

# --- File paths ---
AGENT_REPO_PATH=./repo-surgeon
AGENT_REPO_REMOTE=https://github.com/your-username/repo-surgeon
WORKSPACE_ROOT=/tmp/surgeon-workspace
LOG_ROOT=./logs

# --- Default model for runs (can be overridden per run) ---
DEFAULT_MODEL=anthropic:claude-opus-4-7
FALLBACK_MODEL=openai:gpt-5.1

# --- Dashboard NextAuth (for /dashboard auth — optional) ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-me-with-openssl-rand-hex-32
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# --- Safety knobs ---
MAX_COST_USD_PER_RUN=2.0
MAX_DURATION_S_PER_RUN=1800
MAX_PRS_PER_REPO_PER_DAY=5
